{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - DevDocs{% endblock %}

{% block body %}

<section class="admin-dashboard">

    <div class="admin-welcome">
        <div>
            <span class="admin-label">ESPACE ADMINISTRATEUR</span>
            <h1>Dashboard</h1>
            <p>Bienvenue dans votre espace de gestion DevDocs.</p>
        </div>

        <a href="{{ path('app_home') }}" class="btn btn-outline-primary">
            <i class="bi bi-house"></i> Voir le site
        </a>
    </div>

    <div class="admin-section-title">
        <h2>Gestion de la plateforme</h2>
        <p>Choisissez une section pour gérer votre plateforme.</p>
    </div>

    <div class="row g-4">

        {# Gestion des utilisateurs #}
        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="admin-card-icon users-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>Utilisateurs</h3>
                <p>Consulter les comptes et gérer les rôles des membres.</p>

                <a href="{{ path('app_admin_users') }}" class="admin-card-link">
                    Gérer les utilisateurs
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        {# Gestion des tutoriels #}
        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="admin-card-icon tutorials-icon">
                    <i class="bi bi-book"></i>
                </div>

                <h3>Tutoriels</h3>
                <p>Consulter et modérer les tutoriels publiés.</p>

                <a href="{{ path('app_admin_tutorials') }}" class="admin-card-link">
                    Gérer les tutoriels
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        {# Gestion des commentaires #}
        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="admin-card-icon comments-icon">
                    <i class="bi bi-chat-dots"></i>
                </div>

                <h3>Commentaires</h3>
                <p>Consulter et supprimer les commentaires publiés.</p>

                <a href="{{ path('app_admin_comments') }}" class="admin-card-link">
                    Gérer les commentaires
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        {# Gestion des catégories #}
        <div class="col-md-6 col-lg-3">
            <div class="admin-card">
                <div class="admin-card-icon categories-icon">
                    <i class="bi bi-grid"></i>
                </div>

                <h3>Catégories</h3>
                <p>Ajouter, modifier et supprimer les catégories.</p>

                <a href="{{ path('app_category_crud_index') }}" class="admin-card-link">
                    Gérer les catégories
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="admin-info">
        <div class="admin-info-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div>
            <h4>Espace sécurisé</h4>
            <p>
                Vous êtes connecté en tant qu'administrateur.
                Vous pouvez gérer les utilisateurs et modérer le contenu de DevDocs.
            </p>
        </div>
    </div>

</section>

<style>
    .admin-dashboard {
        padding: 35px 0 60px;
    }

    .admin-welcome {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 50px;
        flex-wrap: wrap;
    }

    .admin-label {
        color: #635bff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .admin-welcome h1 {
        font-size: 36px;
        font-weight: 800;
        color: #111827;
        margin: 10px 0;
    }

    .admin-welcome p,
    .admin-section-title p {
        color: #9ca3af;
        margin-bottom: 0;
    }

    .admin-section-title {
        margin-bottom: 25px;
    }

    .admin-section-title h2 {
        font-size: 23px;
        font-weight: 700;
        color: #111827;
    }

    .admin-card {
        height: 100%;
        padding: 25px;
        background: white;
        border: 1px solid #eef0f5;
        border-radius: 16px;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
    }

    .admin-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
    }

    .admin-card-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        margin-bottom: 20px;
    }

    .users-icon {
        background: #e9e7ff;
        color: #635bff;
    }

    .tutorials-icon {
        background: #e0f2fe;
        color: #0284c7;
    }

    .comments-icon {
        background: #dcfce7;
        color: #16a34a;
    }

    .categories-icon {
        background: #ffedd5;
        color: #ea580c;
    }

    .admin-card h3 {
        font-size: 19px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 10px;
    }

    .admin-card p {
        color: #6b7280;
        font-size: 14px;
        line-height: 1.6;
        flex-grow: 1;
    }

    .admin-card-link {
        color: #635bff;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        margin-top: 15px;
    }

    .admin-card-link:hover {
        color: #5148e5;
    }

    .admin-card-link i {
        margin-left: 5px;
    }

    .admin-info {
        display: flex;
        align-items: center;
        gap: 18px;
        background: #f0efff;
        border: 1px solid #e5e2ff;
        border-radius: 15px;
        padding: 22px;
        margin-top: 40px;
    }

    .admin-info-icon {
        font-size: 30px;
        color: #635bff;
    }

    .admin-info h4 {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 5px;
    }

    .admin-info p {
        font-size: 14px;
        color: #6b7280;
        margin: 0;
    }

    @media (max-width: 576px) {
        .admin-welcome h1 {
            font-size: 29px;
        }
    }
</style>

{% endblock %}
