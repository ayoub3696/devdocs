{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - DevDocs{% endblock %}

{% block body %}

<section class="admin-page">

    <div class="admin-header">
        <div>
            <span class="admin-label">ADMINISTRATION</span>
            <h1>Gestion des utilisateurs</h1>
            <p>Consultez et gérez les membres de DevDocs.</p>
        </div>

        <a href="{{ path('app_home') }}" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Retour à l'accueil
        </a>
    </div>

    <div class="admin-table-card">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Pseudonyme</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>#{{ user.id }}</td>
                            <td>{{ user.pseudonyme }}</td>
                            <td>{{ user.email }}</td>

                            <td>
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge bg-danger">Administrateur</span>
                                {% else %}
                                    <span class="badge bg-primary">Utilisateur</span>
                                {% endif %}
                            </td>

                            <td class="text-end">
                                {% if user != app.user %}
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">

                                        <form method="post"
                                              action="{{ path('app_admin_user_role', {id: user.id}) }}"
                                              onsubmit="return confirm('Confirmer le changement de rôle ?');">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('role' ~ user.id) }}">
                                            <button class="btn btn-sm btn-outline-primary">
                                                {% if 'ROLE_ADMIN' in user.roles %}
                                                    Retirer admin
                                                {% else %}
                                                    Promouvoir admin
                                                {% endif %}
                                            </button>
                                        </form>

                                        <form method="post"
                                              action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                                              onsubmit="return confirm('Supprimer définitivement cet utilisateur ?');">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('delete' ~ user.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </div>
                                {% else %}
                                    <span class="text-muted">Votre compte</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                Aucun utilisateur trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</section>

{% endblock %}
