{% extends 'base.html.twig' %}

{% block title %}Détails de la catégorie - DevDocs{% endblock %}

{% block body %}
<section class="admin-category-page">

    <div class="admin-category-header">
        <div>
            <span class="section-badge">ADMINISTRATION</span>
            <h1>Détails de la catégorie</h1>
            <p>Consultez les informations de cette catégorie.</p>
        </div>

        <a href="{{ path('app_category_crud_index') }}" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="admin-category-card">

        <div class="category-page-icon">
            <i class="bi bi-folder2-open"></i>
        </div>

        <h2>{{ category.name }}</h2>

        <p class="text-muted">
            {{ category.description ?: 'Aucune description disponible.' }}
        </p>

        <div class="tutorial-form-actions mt-4">

            <a href="{{ path('app_category_crud_edit', {'id': category.id}) }}"
               class="btn btn-primary-custom">
                <i class="bi bi-pencil"></i> Modifier
            </a>

            <a href="{{ path('app_category_crud_index') }}"
               class="btn btn-light">
                Retour à la liste
            </a>

            {{ include('category_crud/_delete_form.html.twig') }}

        </div>

    </div>

</section>
{% endblock %}