{% extends 'base.html.twig' %}

{% block title %}Catégories - DevDocs{% endblock %}

{% block body %}

<section class="category-page">

    <div class="category-page-header">
        <div>
            <span class="section-badge">EXPLORATION</span>
            <h1>Explorez les catégories</h1>
            <p>Découvrez les différents domaines du développement et trouvez les tutoriels qui vous intéressent.</p>
        </div>
    </div>

    <div class="category-page-grid">

        {% if categories is not empty %}

            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-md-6 col-lg-4">
                        <article class="category-page-card">

                            <div class="category-page-icon">
                                <i class="bi bi-folder2-open"></i>
                            </div>

                            <h3>{{ category.name }}</h3>

                            <p>
                                {{ category.description ?: 'Découvrez les tutoriels de cette catégorie.' }}
                            </p>

                            <a href="{{ path('app_tutorial_index', {'category': category.id}) }}"
                               class="category-explore-link">
                                Explorer les tutoriels
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </article>
                    </div>
                {% endfor %}
            </div>

        {% else %}

            <div class="tutorial-empty">
                <i class="bi bi-folder-x"></i>
                <h3>Aucune catégorie disponible</h3>
                <p>Les catégories seront bientôt disponibles.</p>
            </div>

        {% endif %}

    </div>

</section>

{% endblock %}