{% extends 'base.html.twig' %}

{% block title %}Publier un tutoriel - DevDocs{% endblock %}

{% block body %}

<section class="tutorial-form-page">

    <a href="{{ path('app_tutorial_index') }}" class="back-link">
        <i class="bi bi-arrow-left"></i> Retour aux tutoriels
    </a>

    <div class="tutorial-form-card">

        <div class="tutorial-form-heading">
            <div class="form-icon">
                <i class="bi bi-file-earmark-plus"></i>
            </div>

            <h1>Partager un tutoriel</h1>
            <p>Partagez vos connaissances et aidez la communauté à progresser.</p>
        </div>

        {{ form_start(form) }}

            <div class="form-field">
                {{ form_label(form.title, 'Titre du tutoriel') }}
                {{ form_widget(form.title, {
                    attr: {
                        class: 'form-control',
                        placeholder: 'Exemple : Apprendre Symfony facilement'
                    }
                }) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="form-field">
                {{ form_label(form.content, 'Contenu du tutoriel') }}
                {{ form_widget(form.content, {
                    attr: {
                        class: 'form-control',
                        rows: 12,
                        placeholder: 'Présentez votre tutoriel et expliquez les étapes...'
                    }
                }) }}
                {{ form_errors(form.content) }}
            </div>

            <div class="form-field">
                {{ form_label(form.category, 'Catégorie') }}
                {{ form_widget(form.category, {
                    attr: { class: 'form-select' }
                }) }}
                {{ form_errors(form.category) }}
            </div>

            <div class="form-field">
                {{ form_label(form.tags, 'Tags') }}
                {{ form_widget(form.tags, {
                    attr: { class: 'form-select' }
                }) }}
                {{ form_errors(form.tags) }}
            </div>

            <div class="tutorial-form-actions">
                <a href="{{ path('app_tutorial_index') }}" class="btn btn-light">
                    Annuler
                </a>

                <button type="submit" class="btn btn-primary-custom">
                    <i class="bi bi-send"></i> Publier le tutoriel
                </button>
            </div>

        {{ form_end(form) }}

    </div>

</section>

{% endblock %}