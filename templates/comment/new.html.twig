{% extends 'base.html.twig' %}

{% block title %}Nouveau commentaire - DevDocs{% endblock %}

{% block body %}
<section class="tutorial-form-page">

    <a href="{{ path('app_comment_index') }}" class="back-link">
        <i class="bi bi-arrow-left"></i> Retour aux commentaires
    </a>

    <div class="tutorial-form-card">
        <div class="tutorial-form-heading">
            <div class="form-icon">
                <i class="bi bi-chat-square-text"></i>
            </div>
            <h1>Ajouter un commentaire</h1>
            <p>Partagez votre avis avec la communauté.</p>
        </div>

        {{ include('comment/_form.html.twig', {
            button_label: 'Publier le commentaire'
        }) }}
    </div>

</section>
{% endblock %}