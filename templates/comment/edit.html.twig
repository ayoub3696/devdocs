{% extends 'base.html.twig' %}

{% block title %}Modifier un commentaire - DevDocs{% endblock %}

{% block body %}
<section class="tutorial-form-page">

    <a href="{{ path('app_comment_index') }}" class="back-link">
        <i class="bi bi-arrow-left"></i> Retour aux commentaires
    </a>

    <div class="tutorial-form-card">
        <div class="tutorial-form-heading">
            <div class="form-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <h1>Modifier le commentaire</h1>
            <p>Modifiez votre commentaire.</p>
        </div>

        {{ include('comment/_form.html.twig', {
            button_label: 'Enregistrer les modifications'
        }) }}
    </div>

</section>
{% endblock %}