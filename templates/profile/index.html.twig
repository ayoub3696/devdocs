{% extends 'base.html.twig' %}

{% block title %}Mon profil - DevDocs{% endblock %}

{% block body %}

<section class="profile-page">

    <div class="profile-header">
        <div class="profile-avatar">
            <i class="bi bi-person-fill"></i>
        </div>

        <h1>Mon profil</h1>
        <p>Bienvenue dans votre espace personnel DevDocs.</p>
    </div>

    <div class="profile-card">

        <div class="profile-card-heading">
            <i class="bi bi-person-vcard"></i>
            <h2>Informations personnelles</h2>
        </div>

        <div class="profile-info">
            <div class="profile-info-item">
                <span>Nom d'utilisateur</span>
                <strong>{{ app.user.pseudonyme }}</strong>
            </div>

            <div class="profile-info-item">
                <span>Adresse e-mail</span>
                <strong>{{ app.user.email }}</strong>
            </div>

            <div class="profile-info-item">
                <span>Type de compte</span>
                <strong>
                    {% if is_granted('ROLE_ADMIN') %}
                        Administrateur
                    {% else %}
                        Utilisateur
                    {% endif %}
                </strong>
            </div>
        </div>

        <div class="profile-actions">
            <a href="{{ path('app_tutorial_index') }}" class="btn btn-primary-custom">
                <i class="bi bi-book"></i> Découvrir les tutoriels
            </a>

            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">
                <i class="bi bi-box-arrow-right"></i> Déconnexion
            </a>
        </div>

    </div>

</section>

{% endblock %}
